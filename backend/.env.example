# BillStack Backend Environment Configuration
# Copy this file to .env and configure your credentials

PORT=5001
FRONTEND_URL=http://localhost:5173

# Gemini API Key (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Google Cloud Vision Credentials
# Absolute path to your Google Cloud service account JSON key file
# e.g., /Users/username/keys/google-cloud-vision-key.json
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/google-cloud-credentials.json
